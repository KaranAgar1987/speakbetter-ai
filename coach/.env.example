# Copy to coach/.env (recommended) or repository-root .env. Never commit real secrets.
# The CLI loads these files automatically; shell exports override file values.

OPENAI_API_KEY=sk-your-key-here
# Optional; default is gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

